# ==============================================================================
# Tech-Docs Generator SPA (.env.example) — Safe to commit and push to Git
# Subsystem: tech-docs-generator (Vite + React SPA)
# Default Dev Port: http://localhost:3001/tech-stack
# ==============================================================================

# Public Vite Development Port (Strictly 3001 — never 3000)
VITE_PORT=3001

# Public URL of the Tech-Docs SPA
# Local Dev:  http://localhost:3001
# Production: https://oando23.vercel.app
NEXT_PUBLIC_TECH_DOCS_URL=http://localhost:3001

# Main Next.js Product Origin (Reference for cross-linking back to catalog/planner)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Admin Public Credentials (Read-only catalog & block descriptors)
# Note: Static Vite build only requires public Anon/Publishable tokens.
# NEVER expose Service Role keys or Database URLs in this client bundle.
# ------------------------------------------------------------------------------
NEXT_ADMIN_SUPABASE_URL=https://rxzpznmxbaoxpikowmfc.supabase.co
NEXT_ADMIN_SUPABASE_ANON_KEY=
NEXT_ADMIN_PUBLISHABLE_KEY=
