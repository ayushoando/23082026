# ==============================================================================
# One&Only Root Environment Template (.env.example)
# Safe to commit and push to Git.
#
# Copy this file to `.env.local` and `site/.env.local` for local development:
#   cp .env.example .env.local
#   cp .env.example site/.env.local
# ==============================================================================

