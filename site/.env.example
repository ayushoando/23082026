# ==============================================================================
# One&Only Site & Platform (.env.example) — Safe to commit and push to Git
# Subsystem: site/ (Next.js 16 App Router on http://localhost:3000)
# Copy to `.env.local` or `site/.env.local` for actual development keys.
# ==============================================================================

# --- 1. Product Origins & Canonical Routing ---
# Local Dev:  http://localhost:3000
# Production: https://oando.co.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_TECH_DOCS_URL=http://localhost:3001
NEXT_PUBLIC_ASSET_BASE_URL=https://oando.co.in

# --- 2. Supabase Products Instance (Catalog, Configurator, Flags) ---
# Project Ref: erpweaiypimorcunaimz
NEXT_PUBLIC_SUPABASE_URL=https://erpweaiypimorcunaimz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=https://erpweaiypimorcunaimz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- 3. Supabase Admin & Auth Instance (Planner, Staff, Descriptors, Profiles) ---
# Project Ref: rxzpznmxbaoxpikowmfc
SUPABASE_AUTH_URL=https://rxzpznmxbaoxpikowmfc.supabase.co
NEXT_ADMIN_SUPABASE_URL=https://rxzpznmxbaoxpikowmfc.supabase.co
NEXT_ADMIN_SUPABASE_ANON_KEY=
NEXT_ADMIN_PUBLISHABLE_KEY=
SUPABASE_ADMIN_SERVICE_ROLE_KEY=

# --- 4. Direct Postgres Connection Strings (Server-Only Drizzle / Scripts) ---
PRODUCTS_DATABASE_URL=
SUPABASE_AUTH_DATABASE_URL=
PLANNER_DATABASE_URL=

# --- 5. AI / LLM Multi-Provider Mesh (Mastra / AI SDK Router) ---
# OpenRouter (Primary fallback gateway)
OPENROUTER_API_KEY_PRIMARY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_BACKUP=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Google Gemini (Native multimodal vision & design advisor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (Direct embedding & structured generation fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Amazon Bedrock (Enterprise failover)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL=us.amazon.nova-lite-v1:0

# LanceDB Vector Database
LANCE_DB_URI=site/.data/lancedb/catalog

# --- 6. Cloudflare R2 / S3 Storage & CDN (Models, Assets, Snapshots) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_CATALOG_BUCKET=oando-asset-cdn
CLOUDFLARE_R2_BUCKET=oando-asset-cdn
R2_CATALOG_BUCKET=oando-asset-cdn
CLOUDFLARE_S3_URL=https://[ACCOUNT_ID].r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_API_TOKEN=

# --- 7. Transactional Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=One&Only <ayush@oando.co.in>
STAFF_NOTIFY_EMAIL=ayush@oando.co.in
RESEND_INBOX=
ADMIN_EMAILS=ayush@oando.co.in

# --- 8. Feature Flags & Operational Modes ---
# Set DEV_AUTH_BYPASS=1 for local disk dev without Supabase auth
DEV_AUTH_BYPASS=0
ACTIVE_THEME_ID=premium-light
SITE_MAINTENANCE_MODE=readonly
NEXT_PUBLIC_CRM_DEMO_MODE=1
SVG_RELEASE_AUTHORITY=db
PNG_DISK_MIRROR=0

# --- 9. Observability, Telemetry & Metrics ---
# Scraping endpoint /api/metrics (Open by default in dev, secured in prod)
METRICS_AUTH_TOKEN=
# New Relic Browser (Pro + SPA). The Browser ingest key is public to the agent,
# but stays in ignored .env.local and is injected by /newrelic.js at runtime.
NEW_RELIC_BROWSER_KEY=
# New Relic OpenTelemetry (Ingest - License key; never use a Browser or User key).
NEW_RELIC_LICENSE_KEY=
OTEL_SERVICE_NAME=ai-planner-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-CTPK6318CR
